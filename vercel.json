{
  "routes": [
    { "src": "/staff/(.*)", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "continue": true },
    { "src": "/dealer/(.*)", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet" }, "continue": true },
    { "src": "/eve", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet" }, "continue": true },
    { "src": "/autozone-apply", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet" }, "continue": true },
    { "src": "/apply/josh", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet" }, "continue": true },
    { "src": "/autozone-staff", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
