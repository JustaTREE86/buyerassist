{
  "routes": [
    {
      "src": "/dealer/ko-cars(/.*)?",
      "status": 308,
      "headers": {
        "Location": "https://brokenmind.com.au/ko$1"
      }
    },
    {
      "src": "/ko-apply(/.*)?",
      "status": 308,
      "headers": {
        "Location": "https://brokenmind.com.au/ko/apply$1"
      }
    },
    {
      "src": "/(apply/josh|autozone-apply)/?",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/staff/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/dealer/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "src": "/autozone-staff",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "src": "/portal-demo",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "src": "/portal-demo/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "src": "/portal/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
