# ============================================================
# The Buyer Assist Group — Apache config for GoDaddy hosting
# ============================================================

# ---- 1. Force HTTPS + non-www -> www (canonical) -----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force www (matches og:url https://www.thebuyerassist.com.au)
  RewriteCond %{HTTP_HOST} ^thebuyerassist\.com\.au$ [NC]
  RewriteRule ^ https://www.thebuyerassist.com.au%{REQUEST_URI} [L,R=301]

  # SPA fallback: any request that is NOT a real file/dir and is
  # NOT inside /assets serves index.html (the app is single-page).
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# ---- 2. Gzip compression (big win for JSX/CSS text) --------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
  # .jsx is served as text and fetched by Babel — compress it too
  <FilesMatch "\.jsx$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>

# ---- 3. Browser caching ------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Images & fonts: cache a long time (filenames change when updated)
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/avif             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  # CSS/JS/JSX: 1 day (edits show up next day; hard-refresh is instant)
  ExpiresByType text/css               "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/babel             "access plus 1 day"
  # HTML: always revalidate so new deploys are picked up immediately
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# .jsx has no default MIME on some hosts — declare it as JS text
AddType application/javascript .jsx

# ---- 4. Basic security headers -----------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Hidden dealer dashboards must never be indexed. The live site runs on
  # Vercel (see vercel.json, which sets the same header); this mirrors it in
  # case the Apache config is ever the one serving traffic.
  <If "%{REQUEST_URI} =~ m#^/dealer/#">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  </If>
  # Don't cache the HTML shell
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- 5. Pretty URLs / defaults -----------------------------
DirectoryIndex index.html
Options -Indexes
